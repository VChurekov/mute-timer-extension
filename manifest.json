{
  "manifest_version": 3,
  "name": "Таймер звука вкладки",
  "description": "Отключает звук вкладки из контекстного меню на 10 сек … 5 мин или на своё время. По истечении таймера звук включается автоматически.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Отключить звук на…"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
